# ========================================================
# IMAP Spam Filter - Fitxer de configuració d'entorn
# ========================================================
# Omple aquests valors i desa el fitxer com: /opt/imap-spam-filter/.env
# Permisos recomanats: sudo chmod 600 /opt/imap-spam-filter/.env

# ── Servidor IMAP comú per al domini ──
# Exemple: imap.exemple.cat o el servidor del teu proveïdor de correu
IMAP_HOST="imap.exemple.cat"
IMAP_PORT=993
IMAP_SSL=true

# ── Bústies d'usuari concurrents (suport multi-compte) ──
# Pots afegir 1, 2, 3 o més comptes amb el format ACCOUNT_N_USER i ACCOUNT_N_PASS
ACCOUNT_1_USER="usuari1@domini.cat"
ACCOUNT_1_PASS="la-teva-contrasenya-1"

ACCOUNT_2_USER="usuari2@domini.cat"
ACCOUNT_2_PASS="la-teva-contrasenya-2"

ACCOUNT_3_USER="usuari3@domini.cat"
ACCOUNT_3_PASS="la-teva-contrasenya-3"

# ── Carpetes IMAP comunes per a tots els comptes ──
# Safata d'entrada on entren els correus
FOLDER_INBOX="INBOX"
# Carpeta on es mourà l'spam detectat automàticament (es crearà si no existeix)
FOLDER_SPAM_DEST="SpamFilter"
# Carpeta on mous manualment l'spam que s'ha colat (per entrenar el filtre)
FOLDER_SPAM_MANUAL="Spam"

# ── Configuració del filtre Rspamd ──
RSPAMD_URL="http://localhost:11333"
RSPAMD_CONTROLLER_URL="http://localhost:11334"
# Puntuació a partir de la qual es considera spam (default: 6.0)
# Baixa a 4.0-5.0 per ser més agressiu, puja a 7.0-8.0 si vols evitar falsos positius
SPAM_THRESHOLD=6.0

# ── Dashboard Web ──
# Port on s'executa el dashboard de control i mètriques (http://raspi:8025)
DASHBOARD_PORT=8025

# ── Base de dades SQLite local ──
DB_PATH="/opt/imap-spam-filter/data/spam_filter.db"

# ── Opcions avançades ──
# Timeout màxim d'espera IMAP IDLE abans de renovar connexió (29 min)
IDLE_TIMEOUT=1740
# Segons entre comprovacions periòdiques de rescat a l'inbox
POLL_INTERVAL=30
# Segons entre rondes d'aprenentatge bayesià de la carpeta Spam manual (1 hora = 3600s)
LEARN_INTERVAL=3600
# Mida màxima d'email a escanejar en bytes (512 KB). Els fitxers més grans es deixen passar
MAX_EMAIL_SIZE=524288
# Dies de retenció per als correus a la carpeta SpamFilter abans d'eliminar-los definitivament (per defecte: 30, 0 per desactivar)
SPAM_RETENTION_DAYS=30
