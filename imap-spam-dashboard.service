[Unit]
Description=IMAP Spam Filter Web Dashboard
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/imap-spam-filter
Environment=ENV_FILE=/opt/imap-spam-filter/.env
ExecStart=/usr/bin/python3 /opt/imap-spam-filter/dashboard.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
